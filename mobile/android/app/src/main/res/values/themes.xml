<?xml version="1.0" encoding="utf-8" ?>
<resources>
    <!-- Base theme: no action bar; Compose draws the entire UI and owns theming.
         Both Pejvak-style canvases are deep teal/navy with white foregrounds, so system bars
         keep light glyphs and transparent scrims from the very first frame. -->
    <style name="Theme.Hawraa" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas_base</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
