# Copy to .env and adjust. Never commit a real .env.
MONGO_URI=mongodb://127.0.0.1:27017/
DB_NAME=hawraa
APP_PORT=1407
ENV=development
# Change this in any non-local deployment.
TOKEN_KEY=hawraa_dev_secret_change_me

# Enables the `audioFile/prepareAudio` act, which mirrors recitation audio onto this server's
# disk on request. Leave it unset and the act refuses to run — that is the intended default,
# because a feature that turns itself on is a feature that is on in production.
# Prefer `deno task audio:mirror` for anything larger than a few files.
# ADMIN_TOKEN=change_me_to_something_random